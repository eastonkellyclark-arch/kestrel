#!/usr/bin/env bash
# Shim — delegates to the Python script in tools/.
# Wired via: git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Try python3 first (Unix/macOS), fall back to python (Windows).
# Test with --version to avoid the Windows Store stub that exists but errors.
if python3 --version >/dev/null 2>&1; then
  exec python3 "$REPO_ROOT/tools/check_secrets.py"
else
  exec python "$REPO_ROOT/tools/check_secrets.py"
fi
