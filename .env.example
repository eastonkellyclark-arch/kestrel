# Kestrel configuration
# Copy to .env and fill in values. .env is gitignored.

# --- Server ---
KESTREL_HOST=127.0.0.1
KESTREL_PORT=8000

# --- Database ---
# Path to the data directory where SQLite lives
KESTREL_DATA_DIR=./data

# --- Adzuna (Phase 8) ---
KESTREL_ADZUNA_APP_ID=
KESTREL_ADZUNA_APP_KEY=
KESTREL_ADZUNA_DAILY_BUDGET=33

# --- USAJobs (Phase 8) ---
KESTREL_USAJOBS_API_KEY=
KESTREL_USAJOBS_EMAIL=

# --- Gmail (Phase 10) ---
KESTREL_GMAIL_CREDENTIALS_JSON=
KESTREL_GMAIL_TOKEN_JSON=

# --- SAM.gov (Phase 11, optional) ---
KESTREL_SAM_API_KEY=

# --- Location ---
KESTREL_HOME_LAT=44.640
KESTREL_HOME_LON=-93.144
KESTREL_ONSITE_RADIUS_KM=80
